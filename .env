# Chromeの実行ファイルのパス
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Chromeのデバッグ用ポート番号
CHROME_PORT=9222
# Chromeのプロファイル保存先
CHROME_USER_DATA_DIR=C:\Users\takem\Workspace\Programming\ContentGenerator\config\chrome_profile
# GeminiのURL
GEMINI_URL=https://gemini.google.com/app?hl=ja
# Geminiの入力用要素
GEMINI_INPUT_SELECTOR=div[contenteditable="true"]
# Geminiの出力用要素
GEMINI_IMG_SELECTOR=model-response img
GEMINI_TXT_SELECTOR=model-response
# フォントデータのパス
FONT_PATH=C:\Windows\Fonts\meiryo.ttc
# 
FFMPEG_PATH=config/ffmpeg/ffmpeg.exe
# 各プロジェクトのディレクトリ
01_DIR=01_generate_text

# 
INPUT_DIRNAME=inputs
OUTPUT_DIRNAME=outputs
PROMPT_DIRNAME=prompts
GENERATED_TEXT_FILENAME=generated_text.txt
BACKGROUND_IMAGE_FILENAME=bg.png
AUDIO_LIST_FILENAME=audio_list.txt
URL_DATA_FILENAME=urls.txt
LOG_FILENAME=log.txt
